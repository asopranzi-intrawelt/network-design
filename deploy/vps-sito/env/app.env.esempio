# Modello delle variabili d'ambiente dell'applicazione in produzione.
#
# Si copia sulla VPS come env/app.env, si riempiono i valori, e quel file non entra mai
# in git: sta accanto al descrittore sulla macchina e i valori si custodiscono nel
# gestore delle password aziendale. Questo modello resta versionato perche' l'elenco
# dei nomi e' documentazione, mentre i valori sono segreti.
#
# PAYLOAD_SECRET e la password della banca dati sono di produzione e si generano nuovi:
# non si riusano quelli di sviluppo, che stanno in chiaro nel repository del sito e che
# il descrittore di sviluppo dichiara esplicitamente non essere segreti.

# Il nome del servizio della banca dati, non localhost: dentro la rete dei contenitori
# l'applicazione raggiunge Postgres per nome. Sulla macchina di sviluppo punta invece a
# localhost perche' la' l'applicazione gira sull'host e non in un contenitore.
DATABASE_URL=postgres://intrawelt:<password-di-produzione>@postgres:5432/intrawelt

# Chiave con cui il gestore di contenuti firma le proprie sessioni. Cambiarla invalida
# le sessioni aperte, quindi si genera una volta e si custodisce.
PAYLOAD_SECRET=<generare-nuovo-e-custodire-nel-gestore>

# L'indirizzo pubblico con cui il sito si vede da fuori. Serve al gestore di contenuti
# per costruire i collegamenti assoluti e deve coincidere con il nome servito dal proxy.
NEXT_PUBLIC_SERVER_URL=https://<nome-del-sito>

NODE_ENV=production
